---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';

export const prerender = true;

// TODO: confirmar con la junta directiva la cuota y el precio de la
// equipación de la temporada vigente. Los valores actuales proceden del
// acta de la asamblea de enero de 2026 (src/content/noticias/acta-asamblea-enero-2026.md).
const ventajasSocio = [
	'Entrenamientos semanales en grupo, con ritmos adaptados a cada nivel.',
	'Correr como equipo en el Circuito Provincial de Carreras Populares de la Diputación de Cuenca.',
	'Equipación oficial a precio de club (chaquetón, camiseta y bolsa para nuevos socios).',
	'Salida anual del club a una gran carrera (Media Maratón y 10K).',
	'Convivencias: comida de hermanamiento y actividades del club.',
	'Participación y voz en la asamblea anual de socios.',
];
---

<Layout
	title="Hazte socio"
	description="Qué incluye ser socio del Club Atletismo San Clemente: cuota anual, equipación oficial a precio de club y cómo darse de alta."
>
	<PageHeader
		eyebrow="Hazte socio"
		title="Únete al club"
		description="Correr es mejor en compañía. Si te gusta correr, el club tiene un sitio para ti, sea cual sea tu nivel."
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<SectionHeading
				eyebrow="Hazte socio"
				title="Qué incluye ser socio"
				description="Ventajas de formar parte del club y todo lo que cubre la cuota anual."
			/>
			<div class="mt-12 grid gap-8 lg:grid-cols-2">
				<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">Ventajas de ser socio</h3>
					<ul class="mt-5 space-y-3">
						{ventajasSocio.map((ventaja) => (
							<li class="flex items-start gap-3 text-sm leading-relaxed text-tinta/75">
								<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-albero-600" />
								<span>{ventaja}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="rounded-2xl border-2 border-albero bg-nocturno p-8 text-white shadow-lg shadow-nocturno/20">
					<p class="text-[11px] font-bold uppercase tracking-[0.15em] text-albero">Cuota anual</p>
					<p class="mt-2 font-display text-4xl font-bold text-albero">50 €</p>
					<p class="mt-2 text-sm leading-relaxed text-white/70">
						El club es una entidad sin ánimo de lucro: la cuota cubre la equipación, la organización
						de la 10K Nocturna y las actividades del año. Plazo habitual: antes de finales de febrero.
					</p>
					<div class="mt-6 rounded-lg bg-white/10 p-4 text-sm leading-relaxed text-white/80">
						<p class="font-semibold text-albero">¿Cómo me apunto?</p>
						<p class="mt-1">
							Escríbenos a {SITE.email} indicando tu talla de equipación y te contamos los pasos.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-tinta/10 bg-white py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<SectionHeading
				eyebrow="Equipación"
				title="Equipación oficial del club"
				description="Precios de la equipación de la temporada para socios, con el chaquetón subvencionado al 50 % por el club."
			/>
			<div class="mt-12 grid gap-6 md:grid-cols-3">
				<div class="rounded-2xl border border-slate-200 bg-hueso p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">Chaquetón</h3>
					<p class="mt-3 font-display text-3xl font-bold text-albero-600">~43 €</p>
					<p class="mt-2 text-sm leading-relaxed text-tinta/70">
						Azul con gorro (Joma, Albacete), con el 50 % subvencionado por el club para socios: pagas
						unos 21 €.
					</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-hueso p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">Nuevos socios</h3>
					<p class="mt-3 font-display text-3xl font-bold text-albero-600">Camiseta + bolsa</p>
					<p class="mt-2 text-sm leading-relaxed text-tinta/70">
						Camiseta del club y bolsa de nueva incorporación incluidas al hacerte socio.
					</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-hueso p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">Jóvenes</h3>
					<p class="mt-3 font-display text-3xl font-bold text-albero-600">35 € / 150 €</p>
					<p class="mt-2 text-sm leading-relaxed text-tinta/70">
						35 € con la camiseta o 150 € con la equipación completa.
					</p>
				</div>
			</div>
			<p class="mt-8 rounded-lg bg-hueso px-4 py-3 text-sm text-tinta/60">
				La equipación se encarga cada temporada en la tienda Joma de Albacete. Al escribirnos, dinos tu
				talla y te indicamos los pasos.
			</p>

			<div class="mt-10 flex flex-wrap justify-center gap-3">
				<a
					href={`mailto:${SITE.email}?subject=${encodeURIComponent('Quiero hacerme socio')}`}
					class="inline-flex items-center gap-2 rounded-md bg-albero px-7 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
				>
					<Icon name="mail" class="h-4 w-4" />
					Quiero hacerme socio
				</a>
				<a
					href="/contacto/"
					class="inline-flex items-center gap-2 rounded-md border-2 border-nocturno px-7 py-3 text-sm font-bold text-nocturno transition hover:bg-nocturno hover:text-white"
				>
					Formas de contacto
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>

	<section class="bg-nocturno py-16 text-white">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
			<Icon name="trophy" class="mx-auto h-10 w-10 text-albero" />
			<h2 class="mt-4 font-display text-3xl font-bold">¿Quieres correr con nosotros?</h2>
			<p class="mt-3 text-white/80">
				El club está abierto a quien quiera correr, en cualquier nivel. Escríbenos y te contamos cómo
				apuntarte y cuándo quedamos a entrenar.
			</p>
			<a
				href={`mailto:${SITE.email}`}
				class="mt-7 inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
			>
				<Icon name="mail" class="h-4 w-4" />
				Contacta con el club
			</a>
		</div>
	</section>
</Layout>
