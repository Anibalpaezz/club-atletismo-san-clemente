---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
import { idiomaDe, t } from '../i18n/ui';
import { ruta } from '../i18n/rutas';

export const prerender = false;
export const revalidate = 60;

// TODO: confirmar con la junta directiva la cuota y el precio de la
// equipación de la temporada vigente. Los valores actuales proceden del
// acta de la asamblea de enero de 2026 (src/content/noticias/acta-asamblea-enero-2026.md).
const lang = idiomaDe(Astro.originPathname ?? Astro.url.pathname);
const ventajasSocio = [1, 2, 3, 4, 5, 6].map((n) => t(lang, `socio.ventaja${n}`));
const asuntoAlta = lang === 'es' ? 'Quiero hacerme socio' : 'I want to join the club';
const comoTexto = t(lang, 'socio.comoTexto').replace('{email}', SITE.email);
---

<Layout title={t(lang, 'socio.tituloPagina')} description={t(lang, 'socio.metaDesc')}>
	<PageHeader
		eyebrow={t(lang, 'socio.eyebrow')}
		title={t(lang, 'socio.titulo')}
		description={t(lang, 'socio.desc')}
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<SectionHeading
				eyebrow={t(lang, 'socio.eyebrow')}
				title={t(lang, 'socio.seccionTitulo')}
				description={t(lang, 'socio.seccionDesc')}
			/>
			<div class="mt-12 grid gap-8 lg:grid-cols-2">
				<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">{t(lang, 'socio.ventajasTitulo')}</h3>
					<ul class="mt-5 space-y-3">
						{ventajasSocio.map((ventaja) => (
							<li class="flex items-start gap-3 text-sm leading-relaxed text-tinta/75">
								<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-albero-600" />
								<span>{ventaja}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="rounded-2xl border-2 border-albero bg-nocturno p-8 text-white shadow-lg shadow-nocturno/20">
					<p class="text-[11px] font-bold uppercase tracking-[0.15em] text-albero">{t(lang, 'socio.cuotaLabel')}</p>
					<p class="mt-2 font-display text-4xl font-bold text-albero">50 €</p>
					<p class="mt-2 text-sm leading-relaxed text-white/70">{t(lang, 'socio.cuotaTexto')}</p>
					<div class="mt-6 rounded-lg bg-white/10 p-4 text-sm leading-relaxed text-white/80">
						<p class="font-semibold text-albero">{t(lang, 'socio.comoTitulo')}</p>
						<p class="mt-1">{comoTexto}</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-tinta/10 bg-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<SectionHeading
				eyebrow={lang === 'es' ? 'Equipación' : 'Kit'}
				title={t(lang, 'socio.equipacionTitulo')}
				description={t(lang, 'socio.equipacionDesc')}
			/>
			<div class="mt-12 grid gap-6 md:grid-cols-3">
				<div class="rounded-2xl border border-slate-200 bg-hueso p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">{t(lang, 'socio.chaquetonTitulo')}</h3>
					<p class="mt-3 font-display text-3xl font-bold text-albero-600">~43 €</p>
					<p class="mt-2 text-sm leading-relaxed text-tinta/70">{t(lang, 'socio.chaquetonTexto')}</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-hueso p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">{t(lang, 'socio.nuevosTitulo')}</h3>
					<p class="mt-3 font-display text-3xl font-bold text-albero-600">{t(lang, 'socio.nuevosPrecio')}</p>
					<p class="mt-2 text-sm leading-relaxed text-tinta/70">{t(lang, 'socio.nuevosTexto')}</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-hueso p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">{t(lang, 'socio.jovenesTitulo')}</h3>
					<p class="mt-3 font-display text-3xl font-bold text-albero-600">35 € / 150 €</p>
					<p class="mt-2 text-sm leading-relaxed text-tinta/70">{t(lang, 'socio.jovenesTexto')}</p>
				</div>
			</div>
			<p class="mt-8 rounded-lg bg-hueso px-4 py-3 text-sm text-tinta/70">{t(lang, 'socio.nota')}</p>

			<div class="mt-10 flex flex-wrap justify-center gap-3">
				<a
					href={`mailto:${SITE.email}?subject=${encodeURIComponent(asuntoAlta)}`}
					class="inline-flex items-center gap-2 rounded-md bg-albero px-7 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
				>
					<Icon name="mail" class="h-4 w-4" />
					{t(lang, 'socio.boton1')}
				</a>
				<a
					href={ruta(lang, '/contacto/')}
					class="inline-flex items-center gap-2 rounded-md border-2 border-nocturno px-7 py-3 text-sm font-bold text-nocturno transition hover:bg-nocturno hover:text-white"
				>
					{t(lang, 'socio.boton2')}
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>
</Layout>
