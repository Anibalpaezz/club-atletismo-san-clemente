---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CarreraBanner from '../components/CarreraBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import MapaRecorrido from '../components/MapaRecorrido.astro';
import InscripcionTarifas from '../components/InscripcionTarifas.astro';
import RecordCircuito from '../components/RecordCircuito.astro';
import PuntosAnimacion from '../components/PuntosAnimacion.astro';
import ResultadosHistoricos from '../components/ResultadosHistoricos.astro';
import { getCollection, render } from 'astro:content';
import { getCarreraConfig } from '../lib/db';
import { SITE } from '../lib/site';

export const prerender = false;
export const revalidate = 60;

const carrera = await getCarreraConfig();
const enlaceInscripcion = carrera?.enlace_inscripcion ?? SITE.inscripcionUrl;

const entradas = await getCollection('carrera', ({ data }) => data.orden);
const renderizados = await Promise.all(
	entradas.map(async (entrada) => ({
		...entrada,
		html: (await render(entrada)).Content,
	})),
);

const recorrido = renderizados.filter((e) => e.data.categoria === 'general');

const servicios = [
	{
		icono: 'trophy' as const,
		titulo: 'Cronometraje y clasificaciones',
		texto: 'Gestionados por Cronomancha/Timingsys, con resultado oficial y chip.',
	},
	{
		icono: 'check' as const,
		titulo: 'Bolsa del corredor',
		texto: 'Todos los inscritos reciben su bolsa del corredor.',
	},
	{
		icono: 'users' as const,
		titulo: 'Fisioterapia',
		texto: 'Servicio gratuito de fisioterapia al finalizar la prueba.',
	},
	{
		icono: 'route' as const,
		titulo: 'Avituallamiento',
		texto: 'Avituallamiento en el recorrido y en la llegada.',
	},
];
---

<Layout
	title="La Carrera · 10K Nocturna"
	description="Carrera Popular 10K Nocturna Villa de San Clemente: recorrido, reglamento, inscripción y clasificaciones. Puntuable para el Circuito Provincial de Cuenca."
>
	<PageHeader
		eyebrow="La Carrera"
		title="10K Nocturna Villa de San Clemente"
		description="La prueba reina del club: 10K nocturnos por el casco histórico iluminado de la Joya del Renacimiento Manchego, con su 5K de iniciación."
	/>

	{carrera && (
		<section class="bg-nocturno pb-16">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<CarreraBanner carrera={carrera} />
			</div>
		</section>
	)}

	<section id="ficha" class="bg-white py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<SectionHeading
				eyebrow="Ficha técnica"
				title="Servicios para el corredor"
				description="Salida a las 22:00 h desde la Plaza Mayor, junto al Antiguo Ayuntamiento renacentista, y una organización pensada para que solo tengas que correr."
			/>
			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{servicios.map((s) => (
					<div class="rounded-xl border border-slate-200 bg-hueso p-7 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
						<span class="flex h-12 w-12 items-center justify-center rounded-full bg-nocturno/5 text-nocturno-600">
							<Icon name={s.icono} class="h-6 w-6" />
						</span>
						<h3 class="mt-5 font-display text-lg font-bold text-nocturno">{s.titulo}</h3>
						<p class="mt-2 text-sm leading-relaxed text-tinta/70">{s.texto}</p>
					</div>
				))}
			</div>

			<div class="mt-10 rounded-xl border border-slate-200 bg-nocturno p-8 text-white">
				<h3 class="font-display text-xl font-bold">Inscripciones</h3>
				<p class="mt-2 text-sm text-white/70">
					La inscripción se realiza exclusivamente a través de
					<span class="font-semibold text-albero">Cronomancha</span>, que gestiona también el
					cronometraje y las clasificaciones. La prueba es puntuable para el XXII Circuito
					Provincial de Carreras Populares de la Diputación de Cuenca.
				</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href={enlaceInscripcion}
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center gap-2 rounded-md bg-albero px-5 py-2.5 text-sm font-bold text-nocturno transition hover:bg-albero-100"
					>
						Inscríbete en Cronomancha
						<Icon name="external" class="h-4 w-4" />
					</a>
					<a
						href="https://www.circuitocarrerasdiputacioncuenca.com"
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-2.5 text-sm font-bold text-white transition hover:border-albero hover:text-albero"
					>
						Circuito Diputación de Cuenca
						<Icon name="external" class="h-4 w-4" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="inscripcion" class="scroll-mt-20 border-t border-tinta/10 bg-white py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<SectionHeading
				eyebrow="Inscripciones"
				title="Tarifas de la edición vigente"
				description="Precios diferenciados para la 10K Nocturna (según inscripción en el Circuito) y para la 5K de iniciación. Bonificaciones y recargos de la próxima edición."
			/>
			<div class="mt-10">
				<InscripcionTarifas
					enlaceInscripcion={enlaceInscripcion}
					textoCta={carrera?.texto_cta}
				/>
			</div>
		</div>
	</section>

	{recorrido.length > 0 && (
		<section id="recorrido" class="scroll-mt-20 bg-hueso py-20">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<SectionHeading
					eyebrow="Recorrido"
					title="Un circuito por el corazón del Renacimiento"
					description="Urbano y llano: Plaza Mayor, Torre Vieja e Iglesia de Santiago Apóstol, con salida y meta junto al Antiguo Ayuntamiento."
				/>
				<div class="mt-10 grid gap-8 lg:grid-cols-2">
					<div class="space-y-8">
						{recorrido.map((entrada) => (
							<article class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
								<h3 class="font-display text-2xl font-bold text-nocturno">{entrada.data.titulo}</h3>
								<div class="prose prose-nocturno mt-4 max-w-none text-tinta/80">
									<entrada.html />
								</div>
							</article>
						))}
					</div>
					<div class="lg:sticky lg:top-24 lg:self-start">
						<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
							<MapaRecorrido />
							<a
								href="https://www.openstreetmap.org/?mlat=39.40387&mlon=-2.42878#map=16/39.40387/-2.42878"
								target="_blank"
								rel="noreferrer noopener"
								class="block bg-white px-4 py-3 text-center text-xs font-semibold text-nocturno transition hover:bg-hueso"
							>
								Ver mapa más grande
							</a>
							<p class="border-t border-slate-200 bg-hueso px-4 py-2 text-center text-[11px] text-tinta/50">
								Datos del mapa © <a href="https://www.openstreetmap.org/" target="_blank" rel="noreferrer noopener" class="underline underline-offset-2 hover:text-nocturno">OpenStreetMap</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	)}

	<section id="reglamento" class="scroll-mt-20 bg-white py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="rounded-2xl border border-slate-200 bg-hueso p-8 sm:p-10">
				<div class="flex flex-wrap items-center justify-between gap-6">
					<div class="max-w-xl">
						<SectionHeading
							align="left"
							eyebrow="Reglamento"
							title="Bases de la prueba"
							description="Normativa completa de la edición vigente: la 10K Nocturna, competitiva y puntuable para el Circuito, y la 5K de iniciación, abierta y no competitiva."
						/>
						<div class="mt-6 flex flex-wrap gap-3">
							<span class="inline-flex rounded-full bg-nocturno px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white">
								10K Nocturna · prueba reina
							</span>
							<span class="inline-flex rounded-full bg-albero/15 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-albero-600">
								5K «Iniciación al deporte saludable»
							</span>
						</div>
					</div>
					<div class="flex flex-col items-start gap-2">
						<a
							href="/carrera/reglamento/"
							class="inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
						>
							Ver bases y reglamento
							<Icon name="arrow-right" class="h-4 w-4" />
						</a>
						<p class="text-xs text-tinta/60">Incluye reglamentos de ediciones anteriores.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<RecordCircuito />

	<PuntosAnimacion />

	<ResultadosHistoricos />

	<section class="bg-nocturno py-16 text-white">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
			<h2 class="font-display text-3xl font-bold">¿Te lo vas a perder?</h2>
			<p class="mt-3 text-white/80">
				Vive una noche de running bajo las estrellas de San Clemente. Plaza Mayor, 22:00 h.
			</p>
			<div class="mt-7 flex flex-wrap justify-center gap-3">
				{enlaceInscripcion && (
					<a
						href={enlaceInscripcion}
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
					>
						{carrera?.texto_cta ?? 'Inscríbete'}
						<Icon name="external" class="h-4 w-4" />
					</a>
				)}
				{carrera?.enlace_clasificaciones && (
					<a
						href={carrera.enlace_clasificaciones}
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center gap-2 rounded-md border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:border-albero hover:text-albero"
					>
						Ver clasificaciones
						<Icon name="external" class="h-4 w-4" />
					</a>
				)}
			</div>
		</div>
	</section>
</Layout>
