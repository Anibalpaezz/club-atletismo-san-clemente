---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../lib/site';

export const prerender = true;

const entradas = await getCollection('carrera', ({ data }) => data.orden);
const renderizados = await Promise.all(
	entradas.map(async (entrada) => ({
		...entrada,
		html: (await render(entrada)).Content,
	})),
);
const reglamento10k = renderizados.find((e) => e.data.categoria === '10k');
const reglamento5k = renderizados.find((e) => e.data.categoria === '5k');

const reglamentosEdiciones = (await getCollection('reglamentos')).sort(
	(a, b) => b.data.year - a.data.year,
);
const reglamentosPasados = reglamentosEdiciones.filter((e) => !e.data.isCurrent);
---

<Layout
	title="Bases y reglamento"
	description="Reglamento completo de la 10K Nocturna Villa de San Clemente y de la 5K de iniciación: categorías, inscripciones, servicios y premios."
>
	<PageHeader
		eyebrow="La Carrera"
		title="Bases y reglamento"
		description="Normativa íntegra de la edición vigente: dos pruebas distintas, dos reglamentos. La 10K Nocturna es competitiva y puntuable para el Circuito; la 5K es una prueba de iniciación, abierta y no competitiva."
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			{reglamento10k && (
				<article class="rounded-2xl border border-slate-200 bg-white p-8 sm:p-10">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<span class="inline-flex rounded-full bg-nocturno px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white">
							10K Nocturna · prueba reina
						</span>
						<a
							href="/carrera/"
							class="inline-flex items-center gap-1.5 text-sm font-semibold text-albero-600 hover:text-nocturno"
						>
							Volver a la carrera
							<Icon name="arrow-right" class="h-4 w-4 rotate-180" />
						</a>
					</div>
					<h2 class="mt-4 font-display text-2xl font-bold text-nocturno">{reglamento10k.data.titulo}</h2>
					<p class="mt-1 text-sm text-tinta/60">
						Competición de 10.000 metros, dos vueltas al circuito urbano, salida a las 22:00 h desde la Plaza Mayor.
					</p>
					<div class="prose prose-nocturno mt-6 max-w-3xl text-tinta/80 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-nocturno [&_ul]:mt-3 [&_ul]:space-y-1.5">
						<reglamento10k.html />
					</div>
				</article>
			)}

			{reglamento5k && (
				<article class="mt-8 rounded-2xl border border-albero/40 bg-white p-8 sm:p-10">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<span class="inline-flex rounded-full bg-albero/15 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-albero-600">
							5K «Iniciación al deporte saludable»
						</span>
					</div>
					<h2 class="mt-4 font-display text-2xl font-bold text-nocturno">{reglamento5k.data.titulo}</h2>
					<p class="mt-1 text-sm text-tinta/60">
						Una sola vuelta al circuito, abierta a corredores y caminantes de todas las edades. No competitiva.
					</p>
					<div class="prose prose-nocturno mt-6 max-w-3xl text-tinta/80 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-nocturno [&_ul]:mt-3 [&_ul]:space-y-1.5">
						<reglamento5k.html />
					</div>
				</article>
			)}

			<div class="mt-10 rounded-2xl border border-slate-200 bg-white">
				<details class="group">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left sm:px-8">
						<span class="font-display text-lg font-bold text-nocturno">Ediciones anteriores</span>
						<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-nocturno/5 text-nocturno transition group-open:rotate-180">
							<Icon name="arrow-right" class="h-4 w-4 rotate-90" />
						</span>
					</summary>
					<div class="border-t border-slate-200 px-6 py-5 sm:px-8">
						{reglamentosPasados.length > 0 ? (
							<ul class="space-y-4">
								{reglamentosPasados.map((entrada) => (
									<li class="flex flex-wrap items-center justify-between gap-3">
										<div>
											<p class="text-sm font-semibold text-nocturno">{entrada.data.titulo}</p>
											<p class="text-xs text-tinta/60">Edición {entrada.data.year}</p>
										</div>
										{entrada.data.pdfUrl && (
											<a
												href={entrada.data.pdfUrl}
												target="_blank"
												rel="noreferrer noopener"
												class="inline-flex items-center gap-1.5 text-sm font-semibold text-albero-600 hover:text-nocturno"
											>
												Ver reglamento
												<Icon name="external" class="h-3.5 w-3.5" />
											</a>
										)}
									</li>
								))}
							</ul>
						) : (
							<p class="text-sm leading-relaxed text-tinta/60">
								Los reglamentos de ediciones anteriores se irán publicando aquí (se añaden como un
								fichero de contenido por año, sin tocar código). Si colaboras con el club y dispones de
								alguno, escríbenos a {SITE.email}.
							</p>
						)}
					</div>
				</details>
			</div>
		</div>
	</section>

	<section class="bg-nocturno py-16 text-white">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
			<h2 class="font-display text-3xl font-bold">¿Dudas con las bases?</h2>
			<p class="mt-3 text-white/80">
				Puedes consultar la ficha de la carrera, las tarifas y el recorrido, o escribirnos directamente.
			</p>
			<div class="mt-7 flex flex-wrap justify-center gap-3">
				<a
					href="/carrera/#inscripcion"
					class="inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
				>
					Tarifas e inscripción
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
				<a
					href={`mailto:${SITE.email}`}
					class="inline-flex items-center gap-2 rounded-md border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:border-albero hover:text-albero"
				>
					<Icon name="mail" class="h-4 w-4" />
					Escríbenos
				</a>
			</div>
		</div>
	</section>
</Layout>
