---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ConsejosTrucos from '../components/ConsejosTrucos.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import Icon from '../components/Icon.astro';
import Establecimientos from '../components/Establecimientos.astro';
import { getNoticiasPublicadas, getPatrocinadores } from '../lib/db';
import { ESTABLECIMIENTOS } from '../lib/comercios';
import { fotosAleatorias } from '../lib/fotosActas';
import { idiomaDe, t } from '../i18n/ui';
import { ruta } from '../i18n/rutas';

export const prerender = false;
export const revalidate = 60;

const lang = idiomaDe(Astro.originPathname ?? Astro.url.pathname);
const noticias = await getNoticiasPublicadas(3);
const patrocinadores = await getPatrocinadores();
const fotosNoticias = fotosAleatorias(noticias.length);

const valoresClub = [
	{ icono: 'users' as const, clave: 1 },
	{ icono: 'route' as const, clave: 2 },
	{ icono: 'flag' as const, clave: 3 },
];

const lugaresRuta = [1, 2, 3];
---

<Layout title={t(lang, 'home.titulo')} description={t(lang, 'home.descripcion')}>
	<Hero />

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<SectionHeading
				eyebrow={t(lang, 'home.club.eyebrow')}
				title={t(lang, 'home.club.titulo')}
				description={t(lang, 'home.club.texto')}
			/>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				{valoresClub.map((valor) => (
					<div class="rounded-xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
						<span class="flex h-12 w-12 items-center justify-center rounded-full bg-nocturno/5 text-nocturno-600">
							<Icon name={valor.icono} class="h-6 w-6" />
						</span>
						<h3 class="mt-5 font-display text-xl font-bold text-nocturno">
							{t(lang, `home.valor${valor.clave}.titulo`)}
						</h3>
						<p class="mt-2 text-sm leading-relaxed text-tinta/70">
							{t(lang, `home.valor${valor.clave}.texto`)}
						</p>
					</div>
				))}
			</div>

			<div class="mt-10 flex justify-center">
				<a
					href={ruta(lang, '/el-club/')}
					class="inline-flex items-center gap-2 rounded-md border-2 border-nocturno px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-nocturno hover:text-white"
				>
					{t(lang, 'home.club.boton')}
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>

	<section class="bg-nocturno py-20 text-white">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<ConsejosTrucos />
		</div>
	</section>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<SectionHeading
				eyebrow={t(lang, 'home.ruta.eyebrow')}
				title={t(lang, 'home.ruta.titulo')}
				description={t(lang, 'home.ruta.texto')}
			/>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				{lugaresRuta.map((lugar, i) => (
					<div class="rounded-xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
						<span class="text-sm font-bold text-albero-600">0{i + 1}</span>
						<h3 class="mt-2 font-display text-xl font-bold text-nocturno">
							{t(lang, `home.lugar${lugar}.titulo`)}
						</h3>
						<p class="mt-2 text-sm leading-relaxed text-tinta/70">
							{t(lang, `home.lugar${lugar}.texto`)}
						</p>
					</div>
				))}
			</div>

			<div class="mt-10 flex justify-center">
				<a
					href={ruta(lang, '/ruta/')}
					class="inline-flex items-center gap-2 rounded-md border-2 border-nocturno px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-nocturno hover:text-white"
				>
					{t(lang, 'home.ruta.boton')}
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>

	<section class="bg-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<SectionHeading
					align="left"
					eyebrow={t(lang, 'home.noticias.eyebrow')}
					title={t(lang, 'home.noticias.titulo')}
					description={t(lang, 'home.noticias.texto')}
				/>
				<a
					href={ruta(lang, '/noticias/')}
					class="inline-flex items-center gap-2 rounded-md border-2 border-nocturno px-5 py-2.5 text-sm font-bold text-nocturno transition hover:bg-nocturno hover:text-white"
				>
					{t(lang, 'home.noticias.boton')}
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
			</div>

			{noticias.length > 0 ? (
				<div class="mt-10 grid gap-6 md:grid-cols-3">
					{noticias.map((n, i) => (
						<NoticiaCard noticia={n} imagenFallback={fotosNoticias[i]} />
					))}
				</div>
			) : (
				<div class="mt-10 rounded-xl border border-dashed border-slate-300 bg-hueso p-10 text-center">
					<p class="text-sm text-tinta/70">{t(lang, 'home.noticias.vacio')}</p>
				</div>
			)}
		</div>
	</section>

	<Establecimientos establecimientos={ESTABLECIMIENTOS} lang={lang} />

	<section class="border-t border-slate-200 bg-hueso py-16">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
				{patrocinadores.length > 0 ? (
					patrocinadores.map((p) =>
						p.url_web ? (
							<a
								href={p.url_web}
								target="_blank"
								rel="noreferrer noopener"
								class="text-lg font-bold text-tinta/700 transition hover:text-nocturno"
							>
								{p.logo_url ? (
									<img src={p.logo_url} alt={p.nombre} class="h-10 w-auto max-w-40 object-contain" loading="lazy" />
								) : (
									p.nombre
								)}
							</a>
						) : (
							<span class="text-lg font-bold text-tinta/700">
								{p.logo_url ? (
									<img src={p.logo_url} alt={p.nombre} class="h-10 w-auto max-w-40 object-contain" loading="lazy" />
								) : (
									p.nombre
								)}
							</span>
						),
					)
				) : (
					<p class="text-sm text-tinta/700">
						{lang === 'es'
							? 'Colaboran: Ayuntamiento de San Clemente · Diputación de Cuenca · Cronomancha'
							: 'With the support of: San Clemente Town Council · Cuenca Provincial Council · Cronomancha'}
					</p>
				)}
			</div>
		</div>
	</section>
</Layout>
