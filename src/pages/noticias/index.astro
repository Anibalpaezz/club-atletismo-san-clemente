---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import { getNoticiasPublicadas } from '../../lib/db';
import { fotosAleatorias } from '../../lib/fotosActas';
import { idiomaDe, t } from '../../i18n/ui';

export const prerender = false;
export const revalidate = 60;

const lang = idiomaDe(Astro.originPathname ?? Astro.url.pathname);
const noticias = await getNoticiasPublicadas(50);
const fotos = fotosAleatorias(noticias.length);
---

<Layout title={t(lang, 'noticias.tituloPagina')} description={t(lang, 'noticias.metaDesc')}>
	<PageHeader
		eyebrow={t(lang, 'noticias.eyebrow')}
		title={t(lang, 'noticias.titulo')}
		description={t(lang, 'noticias.desc')}
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			{noticias.length > 0 ? (
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{noticias.map((n, i) => (
						<NoticiaCard noticia={n} imagenFallback={fotos[i]} />
					))}
				</div>
			) : (
				<div class="rounded-xl border border-dashed border-slate-300 bg-white p-14 text-center">
					<p class="text-lg font-semibold text-nocturno">{t(lang, 'noticias.vacioTitulo')}</p>
					<p class="mt-2 text-sm text-tinta/70">{t(lang, 'noticias.vacioTexto')}</p>
				</div>
			)}
		</div>
	</section>
</Layout>
