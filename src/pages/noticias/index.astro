---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import { getNoticiasPublicadas } from '../../lib/db';

export const prerender = false;
export const revalidate = 60;

const noticias = await getNoticiasPublicadas(50);
---

<Layout
	title="Noticias"
	description="Noticias del Club Atletismo San Clemente y del atletismo popular del circuito provincial de Cuenca."
>
	<PageHeader
		eyebrow="Noticias"
		title="Actualidad del club"
		description="Inscripciones, resultados, entrenamientos y crónicas de las carreras del Circuito Provincial de Carreras Populares de Cuenca."
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			{noticias.length > 0 ? (
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{noticias.map((n) => (
						<NoticiaCard noticia={n} />
					))}
				</div>
			) : (
				<div class="rounded-xl border border-dashed border-slate-300 bg-white p-14 text-center">
					<p class="text-lg font-semibold text-nocturno">Todavía no hay noticias publicadas</p>
					<p class="mt-2 text-sm text-tinta/60">
						En cuanto el club publique sus primeras noticias, aparecerán aquí.
					</p>
				</div>
			)}
		</div>
	</section>
</Layout>
