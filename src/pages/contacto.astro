---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
import { idiomaDe, t } from '../i18n/ui';

export const prerender = false;
export const revalidate = 60;

const lang = idiomaDe(Astro.originPathname ?? Astro.url.pathname);
const asuntoAlta = lang === 'es' ? 'Alta de socio Club Atletismo San Clemente' : 'Club membership — Club Atletismo San Clemente';
const asuntoColab = lang === 'es' ? 'Colaboración con el Club Atletismo San Clemente' : 'Partnership with Club Atletismo San Clemente';

const tarjetas = [
	{
		icono: 'mail' as const,
		titulo: t(lang, 'contacto.correoTitulo'),
		lineas: [SITE.email],
		href: `mailto:${SITE.email}`,
		cta: t(lang, 'contacto.correoCta'),
	},
	{ redes: true, icono: 'users' as const, titulo: t(lang, 'contacto.redesTitulo') },
	{
		icono: 'users' as const,
		titulo: t(lang, 'contacto.socioTitulo'),
		lineas: [t(lang, 'contacto.socioLinea1'), t(lang, 'contacto.socioLinea2')],
		href: `mailto:${SITE.email}?subject=${encodeURIComponent(asuntoAlta)}`,
		cta: t(lang, 'contacto.socioCta'),
	},
];
---

<Layout title={t(lang, 'contacto.tituloPagina')} description={t(lang, 'contacto.metaDesc')}>
	<PageHeader
		eyebrow={t(lang, 'contacto.eyebrow')}
		title={t(lang, 'contacto.titulo')}
		description={t(lang, 'contacto.desc')}
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 xl:px-12">
			<div class="grid gap-6 md:grid-cols-3">
				{tarjetas.map((tarjeta) =>
					tarjeta.redes ? (
						<div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
							<span class="flex h-12 w-12 items-center justify-center rounded-full bg-nocturno/5 text-nocturno-600">
								<Icon name={tarjeta.icono} class="h-6 w-6" />
							</span>
							<h2 class="mt-5 font-display text-xl font-bold text-nocturno">{tarjeta.titulo}</h2>
							<div class="mt-4 space-y-2">
								{[
									{ nombre: t(lang, 'red.blogspot'), href: SITE.blogspot, icono: 'blogspot' as const },
									{
										nombre: 'Facebook',
										href: 'https://www.facebook.com/groups/clubatletismosanclemente/',
										icono: 'facebook' as const,
									},
									{
										nombre: 'Instagram',
										href: 'https://www.instagram.com/clubatletismosanclemente/',
										icono: 'instagram' as const,
									},
								].map((red) => (
									<a
										href={red.href}
										target="_blank"
										rel="noreferrer noopener"
										class="flex items-center gap-3 rounded-md border border-slate-200 px-4 py-3 text-sm font-semibold text-nocturno transition hover:border-nocturno hover:bg-nocturno/5"
									>
										<Icon name={red.icono} class="h-5 w-5 text-albero-600" />
										{red.nombre}
									</a>
								))}
							</div>
						</div>
					) : (
						<a
							href={tarjeta.href}
							class="group rounded-xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
						>
							<span class="flex h-12 w-12 items-center justify-center rounded-full bg-nocturno/5 text-nocturno-600">
								<Icon name={tarjeta.icono} class="h-6 w-6" />
							</span>
							<h2 class="mt-5 font-display text-xl font-bold text-nocturno">{tarjeta.titulo}</h2>
							<ul class="mt-2 space-y-1 text-sm text-tinta/70">
								{(tarjeta.lineas ?? []).map((linea) => (
									<li>{linea}</li>
								))}
							</ul>
							<span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-albero-600">
								{tarjeta.cta}
								<Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
							</span>
						</a>
					),
				)}
			</div>

			<div class="mx-auto mt-16 max-w-7xl rounded-2xl bg-nocturno p-10 text-center text-white">
				<h2 class="font-display text-2xl font-bold">{t(lang, 'contacto.colabTitulo')}</h2>
				<p class="mt-3 text-white/80">{t(lang, 'contacto.colabTexto')}</p>
				<a
					href={`mailto:${SITE.email}?subject=${encodeURIComponent(asuntoColab)}`}
					class="mt-6 inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
				>
					<Icon name="mail" class="h-4 w-4" />
					{t(lang, 'contacto.colabBoton')}
				</a>
			</div>
		</div>
	</section>
</Layout>
