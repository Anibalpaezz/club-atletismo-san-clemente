---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ClubesAmigos from '../components/ClubesAmigos.astro';
import Organigrama from '../components/Organigrama.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { CLUBES_AMIGOS } from '../lib/clubes';
import { GALERIA_HISTORICA } from '../lib/galeria';
import { SITE } from '../lib/site';
import { getCollection, render } from 'astro:content';

export const prerender = true;

const entradas = await getCollection('club', ({ data }) => data.orden);
const renderizados = await Promise.all(
	entradas.map(async (entrada) => ({
		...entrada,
		html: (await render(entrada)).Content,
	})),
);

// TODO: confirmar con la junta directiva la cuota y el precio de la
// equipación de la temporada vigente. Los valores actuales proceden del
// acta de la asamblea de enero de 2026 (src/content/noticias/acta-asamblea-enero-2026.md).
const ventajasSocio = [
	'Entrenamientos semanales en grupo, con ritmos adaptados a cada nivel.',
	'Correr como equipo en el Circuito Provincial de Carreras Populares de la Diputación de Cuenca.',
	'Equipación oficial a precio de club (chaquetón, camiseta y bolsa para nuevos socios).',
	'Salida anual del club a una gran carrera (Media Maratón y 10K).',
	'Convivencias: comida de hermanamiento y actividades del club.',
	'Participación y voz en la asamblea anual de socios.',
];
---

<Layout
	title="El Club"
	description="Historia, valores y directiva del Club Atletismo San Clemente, club de atletismo popular de San Clemente (Cuenca)."
>
	<PageHeader
		eyebrow="El Club"
		title="Club Atletismo San Clemente"
		description="Historia, valores y personas de un club nacido del atletismo popular y del cariño por la Joya del Renacimiento Manchego."
	/>

	<section class="bg-hueso py-20">
		<div class="mx-auto max-w-3xl px-4 sm:px-6">
			{renderizados.map((entrada, i) => (
				<article class={i > 0 ? 'mt-16' : ''}>
					<span class="text-xs font-bold uppercase tracking-[0.2em] text-albero-600">
						0{i + 1}
					</span>
					<h2 class="mt-2 font-display text-3xl font-bold text-nocturno">{entrada.data.titulo}</h2>
					{entrada.data.subtitulo && (
						<p class="mt-1 text-sm font-semibold uppercase tracking-wider text-tinta/50">
							{entrada.data.subtitulo}
						</p>
					)}
					<div class="prose-h2 prose prose-nocturno mt-5 max-w-none text-tinta/80">
						<entrada.html />
					</div>
					{entrada.data.titulo === 'Directiva' && <Organigrama />}
				</article>
			))}
		</div>
	</section>

	<ClubesAmigos clubes={CLUBES_AMIGOS} />

	<section id="galeria" class="scroll-mt-20 border-t border-tinta/10 bg-white py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<SectionHeading
				eyebrow="Memoria fotográfica"
				title="Galería histórica"
				description="Álbumes de las ediciones pasadas de la 10K Nocturna, para revivir noches de running por la Joya del Renacimiento Manchego."
			/>
			{GALERIA_HISTORICA.length > 0 ? (
				<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{GALERIA_HISTORICA.map((album) => (
						<a
							href={album.albumUrl}
							target="_blank"
							rel="noreferrer noopener"
							class="group overflow-hidden rounded-xl border border-slate-200 bg-hueso shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
						>
							<div class="aspect-[16/9] overflow-hidden bg-nocturno/5">
								{album.coverImage ? (
									<img
										src={album.coverImage}
										alt={`Fotos de la 10K Nocturna ${album.year}`}
										class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
										loading="lazy"
									/>
								) : (
									<div class="flex h-full w-full items-center justify-center bg-nocturno/5">
										<Icon name="flag" class="h-10 w-10 text-albero" />
									</div>
								)}
							</div>
							<div class="p-5">
								<p class="text-xs font-bold uppercase tracking-wider text-albero-600">10K Nocturna {album.year}</p>
								{album.descripcion && <p class="mt-1 text-sm text-tinta/70">{album.descripcion}</p>}
								<span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-nocturno">
									Ver álbum
									<Icon name="external" class="h-4 w-4" />
								</span>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="mt-12 rounded-xl border border-dashed border-slate-300 bg-hueso p-10 text-center">
					<p class="text-sm text-tinta/60">
						Los álbumes fotográficos de las ediciones anteriores se irán publicando aquí. ¿Tienes fotos de
						alguna edición? Escríbenos a {SITE.email}.
					</p>
				</div>
			)}
		</div>
	</section>

	<section id="hazte-socio" class="scroll-mt-20 border-t border-tinta/10 bg-hueso py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<SectionHeading
				eyebrow="Hazte socio"
				title="Únete al club"
				description="Correr es mejor en compañía. Si te gusta correr, el club tiene un sitio para ti, sea cual sea tu nivel."
			/>
			<div class="mt-12 grid gap-8 lg:grid-cols-2">
				<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
					<h3 class="font-display text-xl font-bold text-nocturno">Qué incluye ser socio</h3>
					<ul class="mt-5 space-y-3">
						{ventajasSocio.map((ventaja) => (
							<li class="flex items-start gap-3 text-sm leading-relaxed text-tinta/75">
								<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-albero-600" />
								<span>{ventaja}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="space-y-6">
					<div class="rounded-2xl border-2 border-albero bg-nocturno p-8 text-white shadow-lg shadow-nocturno/20">
						<p class="text-[11px] font-bold uppercase tracking-[0.15em] text-albero">Cuota anual</p>
						<p class="mt-2 font-display text-4xl font-bold text-albero">50 €</p>
						<p class="mt-2 text-sm leading-relaxed text-white/70">
							El club es una entidad sin ánimo de lucro: la cuota cubre la equipación, la
							organización de la 10K Nocturna y las actividades del año. Plazo habitual: antes de
							finales de febrero.
						</p>
					</div>

					<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
						<h3 class="font-display text-xl font-bold text-nocturno">Equipación oficial</h3>
						<ul class="mt-4 space-y-3 text-sm leading-relaxed text-tinta/75">
							<li class="flex items-start gap-3">
								<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-albero-600" />
								<span>
									Chaquetón azul con gorro (Joma, Albacete): alrededor de 43 €, con el 50 %
									subvencionado por el club para socios.
								</span>
							</li>
							<li class="flex items-start gap-3">
								<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-albero-600" />
								<span>Camiseta del club y bolsa de nueva incorporación para nuevos socios.</span>
							</li>
							<li class="flex items-start gap-3">
								<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-albero-600" />
								<span>Jóvenes: 35 € con camiseta o 150 € con la equipación completa.</span>
							</li>
						</ul>
						<p class="mt-4 rounded-lg bg-hueso px-4 py-3 text-sm text-tinta/60">
							La equipación se encarga cada temporada en la tienda Joma de Albacete. Al escribirnos,
							dinos tu talla y te indicamos los pasos.
						</p>
					</div>
				</div>
			</div>

			<div class="mt-10 flex justify-center">
				<a
					href={`mailto:${SITE.email}?subject=${encodeURIComponent('Quiero hacerme socio')}`}
					class="inline-flex items-center gap-2 rounded-md bg-albero px-7 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
				>
					<Icon name="mail" class="h-4 w-4" />
					Quiero hacerme socio
				</a>
			</div>
		</div>
	</section>

	<section class="bg-nocturno py-16 text-white">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
			<Icon name="trophy" class="mx-auto h-10 w-10 text-albero" />
			<h2 class="mt-4 font-display text-3xl font-bold">¿Quieres correr con nosotros?</h2>
			<p class="mt-3 text-white/80">
				El club está abierto a quien quiera correr, en cualquier nivel. Escríbenos y te contamos
				cómo apuntarte y cuándo quedamos a entrenar.
			</p>
			<a
				href={`mailto:${SITE.email}`}
				class="mt-7 inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
			>
				<Icon name="mail" class="h-4 w-4" />
				Contacta con el club
			</a>
		</div>
	</section>
</Layout>
