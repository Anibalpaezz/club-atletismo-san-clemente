---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { idiomaDe, t } from '../i18n/ui';
import { ruta } from '../i18n/rutas';

export const prerender = false;

const lang = idiomaDe(Astro.originPathname ?? Astro.url.pathname);
---

<Layout title={t(lang, 'error.metaTitulo')}>
	<section class="bg-nocturno py-32 text-white">
		<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8 xl:px-12">
			<p class="text-xs font-bold uppercase tracking-[0.3em] text-albero">Error 404</p>
			<h1 class="mt-4 font-display text-4xl font-bold sm:text-5xl">{t(lang, 'error.titulo')}</h1>
			<p class="mt-5 text-white/80">{t(lang, 'error.texto')}</p>
			<a
				href={ruta(lang, '/')}
				class="mt-8 inline-flex items-center gap-2 rounded-md bg-albero px-6 py-3 text-sm font-bold text-nocturno transition hover:bg-albero-100"
			>
				{t(lang, 'error.boton')}
				<Icon name="arrow-right" class="h-4 w-4" />
			</a>
		</div>
	</section>
</Layout>
