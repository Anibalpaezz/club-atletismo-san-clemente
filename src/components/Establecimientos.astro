---
import type { Establecimiento } from '../lib/comercios';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
	establecimientos: Establecimiento[];
}
const { establecimientos } = Astro.props;
---

<section class="border-t border-slate-200 bg-white py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Comercios y servicios locales"
			title="Establecimientos que nos apoyan"
			description="Los comercios y negocios de San Clemente que colaboran con el club y con la 10K Nocturna: tiendas, bodegas, bancos y servicios de la villa."
		/>
		<div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
			{establecimientos.map((establecimiento) => (
				<a
					href={establecimiento.url_web}
					target={establecimiento.url_web ? '_blank' : undefined}
					rel={establecimiento.url_web ? 'noreferrer noopener' : undefined}
					class="group flex flex-col items-center justify-between rounded-xl border border-slate-200 bg-hueso p-5 text-center transition hover:-translate-y-0.5 hover:shadow-md"
				>
					<div class="flex h-20 w-full items-center justify-center">
						{establecimiento.imagen ? (
							<img
								src={establecimiento.imagen}
								alt={`Logo de ${establecimiento.nombre}`}
								loading="lazy"
								class="max-h-16 w-auto max-w-full object-contain transition group-hover:scale-[1.03]"
							/>
						) : (
							<span class="font-display text-base font-bold text-nocturno">{establecimiento.nombre}</span>
						)}
					</div>
					<div class="mt-4">
						<p class="font-display text-sm font-bold leading-snug text-nocturno">{establecimiento.nombre}</p>
						{establecimiento.detalle && (
							<p class="mt-1 text-xs leading-relaxed text-tinta/60">{establecimiento.detalle}</p>
						)}
					</div>
					{establecimiento.url_web && (
						<span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-albero-600">
							Visitar
							<Icon name="external" class="h-3 w-3" />
						</span>
					)}
				</a>
			))}
		</div>
	</div>
</section>
