---
// Modal de noticias: al pulsar una tarjeta se abre la noticia aquí mismo en vez
// de navegar. El contenido se pide por fetch a la propia ficha (que sigue
// existiendo para enlaces directos, buscadores y compartir) y se inyecta en el
// diálogo. Mismo ancho que los diálogos de Conseytruk.
import { idiomaDe, t } from '../i18n/ui';

const lang = idiomaDe(Astro.originPathname ?? Astro.url.pathname);
---

<dialog
	id="modal-noticia"
	aria-labelledby="modal-noticia-titulo"
	class="m-auto max-h-[85vh] w-[min(94vw,52.8rem)] overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-tinta shadow-2xl shadow-black/50 backdrop:bg-nocturno/80"
>
	<div class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5">
		<div class="min-w-0">
			<p
				data-modal-fecha
				class="text-xs font-semibold uppercase tracking-wider text-albero-600 empty:hidden"
			></p>
			<h2
				id="modal-noticia-titulo"
				data-modal-titulo
				class="mt-1 font-display text-xl font-bold leading-snug text-nocturno sm:text-2xl"
			></h2>
		</div>
		<form method="dialog">
			<button
				type="submit"
				aria-label={t(lang, 'noticias.cerrar')}
				class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 text-lg leading-none text-tinta/70 transition hover:border-nocturno hover:text-nocturno"
			>
				<span aria-hidden="true">×</span>
			</button>
		</form>
	</div>

	<div class="max-h-[70vh] overflow-y-auto px-6 py-6">
		<p data-modal-cargando class="text-sm text-tinta/60">{t(lang, 'noticias.cargando')}</p>
		<img data-modal-imagen alt="" class="mb-6 hidden aspect-[16/9] w-full rounded-xl object-cover" />
		<p
			data-modal-resumen
			class="mb-6 hidden border-l-4 border-albero pl-4 text-base italic leading-relaxed text-nocturno/80"
		></p>
		<div
			data-modal-cuerpo
			class="prose prose-nocturno mt-2 max-w-none break-words text-tinta/80 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-nocturno [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-nocturno"
		></div>
	</div>
</dialog>

<script>
	const dialogo = document.getElementById('modal-noticia');

	if (dialogo instanceof HTMLDialogElement) {
		const titulo = dialogo.querySelector<HTMLElement>('[data-modal-titulo]');
		const fecha = dialogo.querySelector<HTMLElement>('[data-modal-fecha]');
		const imagen = dialogo.querySelector<HTMLImageElement>('[data-modal-imagen]');
		const resumen = dialogo.querySelector<HTMLElement>('[data-modal-resumen]');
		const cuerpo = dialogo.querySelector<HTMLElement>('[data-modal-cuerpo]');
		const cargando = dialogo.querySelector<HTMLElement>('[data-modal-cargando]');

		const abrir = async (href: string) => {
			if (!titulo || !fecha || !imagen || !resumen || !cuerpo || !cargando) return;

			titulo.textContent = '';
			fecha.textContent = '';
			resumen.textContent = '';
			cuerpo.textContent = '';
			imagen.removeAttribute('src');
			imagen.hidden = true;
			resumen.hidden = true;
			cargando.hidden = false;

			dialogo.showModal();
			document.documentElement.classList.add('overflow-hidden');

			try {
				const respuesta = await fetch(href, { headers: { Accept: 'text/html' } });
				if (!respuesta.ok) throw new Error(String(respuesta.status));

				const doc = new DOMParser().parseFromString(await respuesta.text(), 'text/html');
				const articulo = doc.querySelector('[data-noticia-articulo]');
				if (!articulo) throw new Error('sin artículo');

				titulo.textContent = articulo.querySelector('[data-noticia-titulo]')?.textContent?.trim() ?? '';
				fecha.textContent = articulo.querySelector('[data-noticia-fecha]')?.textContent?.trim() ?? '';

				const imagenFuente = articulo.querySelector('[data-noticia-imagen]');
				const src = imagenFuente?.getAttribute('src');
				if (src) {
					imagen.src = src;
					imagen.alt = imagenFuente?.getAttribute('alt') ?? '';
					imagen.hidden = false;
				}

				const resumenFuente = articulo.querySelector('[data-noticia-resumen]');
				if (resumenFuente?.textContent?.trim()) {
					resumen.textContent = resumenFuente.textContent.trim();
					resumen.hidden = false;
				}

				const cuerpoFuente = articulo.querySelector('[data-noticia-cuerpo]');
				if (!cuerpoFuente) throw new Error('sin cuerpo');

				cuerpo.innerHTML = cuerpoFuente.innerHTML;

				cargando.hidden = true;
				dialogo.querySelector<HTMLElement>('form button')?.focus();
			} catch {
				// Si el fetch falla, que la noticia se abra como siempre.
				dialogo.close();
				window.location.href = href;
			}
		};

		document.addEventListener('click', (evento) => {
			if (!(evento.target instanceof Element)) return;
			const enlace = evento.target.closest('a[data-abrir-noticia]');
			if (!(enlace instanceof HTMLAnchorElement)) return;
			if (evento.defaultPrevented || evento.button !== 0) return;
			if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
			evento.preventDefault();
			void abrir(enlace.href);
		});

		// Cerrar al pulsar el fondo (el contenido no propaga el clic al diálogo).
		dialogo.addEventListener('click', (evento) => {
			if (evento.target === dialogo) dialogo.close();
		});

		dialogo.addEventListener('close', () => {
			document.documentElement.classList.remove('overflow-hidden');
		});
	}
</script>
