---
import Icon from './Icon.astro';
import { CAPITULOS, INTRO_CONSEJOS, ORIGEN_CONSEJOS } from '../lib/consejos';
---

<div>
	<div class="flex flex-wrap items-end justify-between gap-6">
		<div class="max-w-3xl">
			<p class="text-xs font-bold uppercase tracking-[0.2em] text-albero">Conseytruk</p>
			<h2 class="mt-2 font-display text-2xl font-bold text-white sm:text-3xl">
				Consejos y trucos para nuestro deporte
			</h2>
			<p class="mt-3 text-base leading-relaxed text-white/70">{INTRO_CONSEJOS}</p>
		</div>
		<a
			href={ORIGEN_CONSEJOS}
			target="_blank"
			rel="noreferrer noopener"
			class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-2.5 text-sm font-bold text-white transition hover:border-albero hover:text-albero"
		>
			Ver los 100 consejos
			<Icon name="external" class="h-4 w-4" />
		</a>
	</div>

	<div class="mt-8 grid items-start gap-4 md:grid-cols-2">
		{
			CAPITULOS.map((capitulo, i) => (
				<details
					class:list={[
						'group overflow-hidden rounded-xl border border-white/10 bg-white/5 transition open:border-albero/40 open:bg-white/10',
						i === CAPITULOS.length - 1 && CAPITULOS.length % 2 === 1 ? 'md:col-span-2' : '',
					]}
				>
					<summary class="flex cursor-pointer list-none items-start gap-3 p-5 [&::-webkit-details-marker]:hidden">
						<span class="font-display text-xl font-bold leading-none text-albero">
							{String(capitulo.numero).padStart(2, '0')}
						</span>
						<span class="min-w-0 flex-1">
							<span class="block font-display text-lg font-bold leading-snug text-white">
								{capitulo.titulo}
							</span>
							<span class="mt-1 block text-[11px] font-semibold uppercase tracking-[0.15em] text-white/50">
								Consejos {capitulo.consejos[0].numero}–{capitulo.consejos[capitulo.consejos.length - 1].numero} ·
								<span class="text-albero/80">desplegar</span>
							</span>
						</span>
						<Icon
							name="arrow-right"
							class="mt-1 h-4 w-4 shrink-0 text-white/60 transition group-open:rotate-90 group-open:text-albero"
						/>
					</summary>
					<div class="border-t border-white/10 px-5 pb-5 pt-4">
						<p class="text-sm leading-relaxed text-white/60">{capitulo.resumen}</p>
						<ol class="mt-4 space-y-4">
							{capitulo.consejos.map((consejo) => (
								<li class="flex gap-3 text-sm leading-relaxed text-white/80">
									<span class="w-6 shrink-0 text-right font-display text-sm font-bold text-albero">
										{consejo.numero}.
									</span>
									<span>{consejo.texto}</span>
								</li>
							))}
						</ol>
					</div>
				</details>
			))
		}
	</div>
</div>
