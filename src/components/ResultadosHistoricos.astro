---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const resultados = (await getCollection('resultados')).sort((a, b) => b.data.year - a.data.year);
---

<section id="resultados" class="scroll-mt-20 border-t border-tinta/10 bg-hueso py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Histórico"
			title="Resultados de ediciones anteriores"
			description="Clasificaciones oficiales de la 10K Nocturna publicadas por Cronomancha. Añade una nueva edición con un simple fichero de contenido."
		/>

		{resultados.length > 0 ? (
			<div class="mt-12 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="border-b border-slate-200 bg-hueso text-xs font-bold uppercase tracking-wider text-tinta/60">
							<th scope="col" class="px-6 py-4">Edición</th>
							<th scope="col" class="hidden px-6 py-4 sm:table-cell">Participantes</th>
							<th scope="col" class="px-6 py-4 text-right">Clasificación oficial</th>
						</tr>
					</thead>
					<tbody>
						{resultados.map((r) => (
							<tr class="border-b border-slate-100 transition last:border-0 hover:bg-hueso">
								<td class="px-6 py-4">
									<span class="font-display text-lg font-bold text-nocturno">{r.data.year}</span>
								</td>
								<td class="hidden px-6 py-4 text-tinta/70 sm:table-cell">
									{r.data.participantCount ? `${r.data.participantCount} corredores/as` : '—'}
								</td>
								<td class="px-6 py-4 text-right">
									<a
										href={r.data.cronomanchaPdfUrl}
										target="_blank"
										rel="noreferrer noopener"
										class="inline-flex items-center gap-1.5 text-sm font-semibold text-albero-600 transition hover:text-nocturno"
									>
										Ver clasificación
										<Icon name="external" class="h-3.5 w-3.5" />
									</a>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<div class="mt-12 rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
				<p class="text-sm text-tinta/60">
					Las clasificaciones oficiales de ediciones anteriores se irán publicando aquí.
				</p>
			</div>
		)}
	</div>
</section>