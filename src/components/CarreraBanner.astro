---
import type { CarreraConfig } from '../lib/supabase';
import { formatFecha } from '../lib/formato';
import Icon from './Icon.astro';

interface Props {
	carrera: CarreraConfig;
}
const { carrera } = Astro.props;
const fecha = formatFecha(carrera.fecha ?? null);

const fichas = [
	carrera.fecha ? { icono: 'calendar' as const, label: 'Fecha', valor: fecha || 'Próximamente' } : null,
	{ icono: 'clock' as const, label: 'Salida', valor: carrera.hora ? `${carrera.hora} h` : '22:00 h' },
	{ icono: 'map-pin' as const, label: 'Lugar', valor: carrera.lugar ?? 'Plaza Mayor, San Clemente' },
	{ icono: 'trophy' as const, label: 'Prueba', valor: '10K + 5K de iniciación' },
].filter(Boolean) as { icono: 'calendar' | 'clock' | 'map-pin' | 'trophy'; label: string; valor: string }[];
---

<div class="rounded-2xl border border-albero/30 bg-nocturno text-white shadow-xl shadow-nocturno/20">
	<div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 px-6 py-5 sm:px-8">
		<div>
			<p class="text-xs font-bold uppercase tracking-widest text-albero">Carrera Popular 10K Nocturna</p>
			<h3 class="mt-1 font-display text-2xl font-bold">Villa de San Clemente</h3>
		</div>
		{carrera.edicion && (
			<span class="rounded-full border border-albero/40 bg-albero/10 px-4 py-1 text-sm font-semibold text-albero">
				{carrera.edicion}
			</span>
		)}
	</div>

	<dl class="grid gap-6 px-6 py-6 sm:grid-cols-2 sm:px-8 lg:grid-cols-4">
		{fichas.map((ficha) => (
			<div class="flex items-start gap-3">
				<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-albero/15 text-albero">
					<Icon name={ficha.icono} class="h-5 w-5" />
				</span>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-wider text-white/50">{ficha.label}</dt>
					<dd class="mt-0.5 text-sm font-semibold leading-snug">{ficha.valor}</dd>
				</div>
			</div>
		))}
	</dl>

	<div class="flex flex-wrap gap-3 border-t border-white/10 px-6 py-5 sm:px-8">
		{carrera.enlace_inscripcion && (
			<a
				href={carrera.enlace_inscripcion}
				target="_blank"
				rel="noreferrer noopener"
				class="inline-flex items-center gap-2 rounded-md bg-albero px-5 py-2.5 text-sm font-bold text-nocturno transition hover:bg-albero-100"
			>
				{carrera.texto_cta ?? 'Inscríbete'}
				<Icon name="external" class="h-4 w-4" />
			</a>
		)}
		{carrera.enlace_clasificaciones && (
			<a
				href={carrera.enlace_clasificaciones}
				target="_blank"
				rel="noreferrer noopener"
				class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-2.5 text-sm font-bold text-white transition hover:border-albero hover:text-albero"
			>
				Clasificaciones
				<Icon name="external" class="h-4 w-4" />
			</a>
		)}
		<a
			href="/carrera/"
			class="inline-flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold text-white/70 transition hover:text-white"
		>
			Toda la información
			<Icon name="arrow-right" class="h-4 w-4" />
		</a>
	</div>
</div>
