---
import type { CarreraConfig } from '../lib/supabase';
import { formatFecha } from '../lib/formato';
import Icon from './Icon.astro';

interface Props {
	carrera: CarreraConfig;
}
const { carrera } = Astro.props;
const fecha = formatFecha(carrera.fecha ?? null);

const fichas = [
	carrera.fecha ? { icono: 'calendar' as const, label: 'Fecha', valor: fecha || 'Próximamente' } : null,
	{ icono: 'clock' as const, label: 'Salida', valor: carrera.hora ? `${carrera.hora} h` : '22:00 h' },
	{ icono: 'map-pin' as const, label: 'Lugar', valor: carrera.lugar ?? 'Plaza Mayor, San Clemente' },
	{ icono: 'trophy' as const, label: 'Prueba', valor: '10K + 5K de iniciación' },
].filter(Boolean) as { icono: 'calendar' | 'clock' | 'map-pin' | 'trophy'; label: string; valor: string }[];
---

<div class="rounded-2xl border border-albero/30 bg-nocturno text-white shadow-xl shadow-nocturno/20">
	<div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 px-6 py-5 sm:px-8">
		<div>
			<p class="text-xs font-bold uppercase tracking-widest text-albero">Carrera Popular 10K Nocturna</p>
			<h3 class="mt-1 font-display text-2xl font-bold">Villa de San Clemente</h3>
		</div>
		{carrera.edicion && (
			<span class="rounded-full border border-albero/40 bg-albero/10 px-4 py-1 text-sm font-semibold text-albero">
				{carrera.edicion}
			</span>
		)}
	</div>

	<dl class="grid gap-6 px-6 py-6 sm:grid-cols-2 sm:px-8 lg:grid-cols-4">
		{fichas.map((ficha) => (
			<div class="flex items-start gap-3">
				<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-albero/15 text-albero">
					<Icon name={ficha.icono} class="h-5 w-5" />
				</span>
				<div>
					<dt class="text-xs font-semibold uppercase tracking-wider text-white/50">{ficha.label}</dt>
					<dd class="mt-0.5 text-sm font-semibold leading-snug">{ficha.valor}</dd>
				</div>
			</div>
		))}
	</dl>

	{carrera.fecha && (
		<div
			class="border-t border-white/10 px-6 py-5 sm:px-8"
			data-cuenta-atras
			data-fecha={carrera.fecha}
			data-hora={carrera.hora ?? '22:00'}
		>
			<p class="text-xs font-semibold uppercase tracking-widest text-white/50">Cuenta atrás para la salida</p>
			<div class="mt-3 grid max-w-md grid-cols-4 gap-3">
				<div class="rounded-lg bg-white/10 px-2 py-2.5 text-center">
					<p data-valor class="font-display text-2xl font-bold tabular-nums text-albero">–</p>
					<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/50">días</p>
				</div>
				<div class="rounded-lg bg-white/10 px-2 py-2.5 text-center">
					<p data-valor class="font-display text-2xl font-bold tabular-nums text-albero">–</p>
					<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/50">horas</p>
				</div>
				<div class="rounded-lg bg-white/10 px-2 py-2.5 text-center">
					<p data-valor class="font-display text-2xl font-bold tabular-nums text-albero">–</p>
					<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/50">min</p>
				</div>
				<div class="rounded-lg bg-white/10 px-2 py-2.5 text-center">
					<p data-valor class="font-display text-2xl font-bold tabular-nums text-albero">–</p>
					<p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/50">seg</p>
				</div>
			</div>
			<p class="caja-fin hidden mt-3 text-sm font-semibold text-albero">
				¡Gracias por correr con nosotros!
			</p>
		</div>
	)}

	<div class="flex flex-wrap gap-3 border-t border-white/10 px-6 py-5 sm:px-8">
		{carrera.enlace_inscripcion && (
			<a
				href={carrera.enlace_inscripcion}
				target="_blank"
				rel="noreferrer noopener"
				class="inline-flex items-center gap-2 rounded-md bg-albero px-5 py-2.5 text-sm font-bold text-nocturno transition hover:bg-albero-100"
			>
				{carrera.texto_cta ?? 'Inscríbete'}
				<Icon name="external" class="h-4 w-4" />
			</a>
		)}
		{carrera.enlace_clasificaciones && (
			<a
				href={carrera.enlace_clasificaciones}
				target="_blank"
				rel="noreferrer noopener"
				class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-2.5 text-sm font-bold text-white transition hover:border-albero hover:text-albero"
			>
				Clasificaciones
				<Icon name="external" class="h-4 w-4" />
			</a>
		)}
		<a
			href="/carrera/"
			class="inline-flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold text-white/70 transition hover:text-white"
		>
			Toda la información
			<Icon name="arrow-right" class="h-4 w-4" />
		</a>
	</div>
</div>

<script>
	function inicializarCuentasAtras() {
		document.querySelectorAll<HTMLElement>('[data-cuenta-atras]').forEach((bloque) => {
			const fecha = bloque.dataset.fecha;
			if (!fecha) return;
			const [hh, mm] = (bloque.dataset.hora ?? '22:00').split(':').map(Number);
			const objetivo = new Date(fecha);
			objetivo.setHours(Number.isNaN(hh) ? 22 : hh, Number.isNaN(mm) ? 0 : mm, 0, 0);

			const cajas = bloque.querySelectorAll<HTMLElement>('[data-valor]');
			const fin = bloque.querySelector<HTMLElement>('.caja-fin');
			let intervalo: number | null = null;

			const actualizar = () => {
				const resto = objetivo.getTime() - Date.now();
				if (resto <= 0) {
					cajas.forEach((el) => (el.textContent = '0'));
					if (fin) fin.classList.remove('hidden');
					if (intervalo !== null) window.clearInterval(intervalo);
					return;
				}
				const seg = Math.floor(resto / 1000);
				const valores = [
					Math.floor(seg / 86400),
					Math.floor((seg % 86400) / 3600),
					Math.floor((seg % 3600) / 60),
					seg % 60,
				];
				cajas.forEach((el, i) => (el.textContent = String(valores[i] ?? 0).padStart(2, '0')));
			};

			// Solo se ejecuta mientras el bloque sea visible (evita tics al cargar).
			const observador = new IntersectionObserver(
				(entradas) => {
					entradas.forEach((entrada) => {
						if (!entrada.isIntersecting) return;
						if (intervalo === null) {
							actualizar();
							intervalo = window.setInterval(actualizar, 1000);
						}
						observador.disconnect();
					});
				},
				{ threshold: 0.2 },
			);
			observador.observe(bloque);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', inicializarCuentasAtras);
	} else {
		inicializarCuentasAtras();
	}

	document.addEventListener('astro:page-load', inicializarCuentasAtras);
</script>
