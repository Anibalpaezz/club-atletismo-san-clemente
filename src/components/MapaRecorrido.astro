---
import 'leaflet/dist/leaflet.css';
import { TRACKS } from '../lib/tracks';
---

<div class="h-full w-full">
	<div
		id="mapa-recorrido"
		class="h-80 w-full bg-amber-50 sm:h-96 lg:h-[28rem]"
		aria-label="Mapa del circuito urbano de la Carrera Nocturna Villa de San Clemente"
	></div>

	<div class="border-t border-slate-200 bg-white px-4 py-3">
		<div class="flex flex-wrap items-center gap-2">
			<a
				href={TRACKS.gpxUrl}
				download
				class="inline-flex items-center gap-1.5 rounded-md bg-nocturno px-4 py-2 text-xs font-bold text-white transition hover:bg-nocturno-700"
			>
				Descargar GPX
			</a>
			{TRACKS.wikilocUrl && (
				<a
					href={TRACKS.wikilocUrl}
					target="_blank"
					rel="noreferrer noopener"
					class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 px-4 py-2 text-xs font-bold text-nocturno transition hover:border-albero-600 hover:text-nocturno-600"
				>
					Ver en Wikiloc
				</a>
			)}
			{TRACKS.stravaUrl && (
				<a
					href={TRACKS.stravaUrl}
					target="_blank"
					rel="noreferrer noopener"
					class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 px-4 py-2 text-xs font-bold text-nocturno transition hover:border-albero-600 hover:text-nocturno-600"
				>
					Ver en Strava
				</a>
			)}
		</div>
	</div>

	<div class="border-t border-slate-200 bg-hueso px-4 py-4">
		<p class="text-[11px] font-semibold uppercase tracking-wider text-tinta/50">Perfil del recorrido</p>
		<svg
			viewBox="0 0 600 96"
			class="mt-2 h-20 w-full"
			role="img"
			aria-label="Perfil del recorrido de la 10K Nocturna: circuito urbano prácticamente llano"
		>
			<line x1="0" y1="78" x2="600" y2="78" stroke="#1f2430" stroke-opacity="0.2" stroke-width="1" />
			<line x1="0" y1="30" x2="600" y2="30" stroke="#8d99ae" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3 4" />
			<line x1="300" y1="20" x2="300" y2="78" stroke="#1f2430" stroke-opacity="0.15" stroke-width="1" stroke-dasharray="4 4" />
			<polyline
				points="0,40 40,36 80,42 120,34 160,40 200,36 240,42 280,34 320,40 360,36 400,42 440,34 480,40 520,36 560,42 600,34"
				fill="none"
				stroke="#c9a24b"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
			<polyline
				points="0,40 60,38 120,41 180,35 240,41 300,37 360,41 420,35 480,41 540,38 600,34"
				fill="none"
				stroke="#0a1f44"
				stroke-width="1.5"
				stroke-dasharray="4 4"
				opacity="0.45"
			/>
			<text x="6" y="88" fill="#1f2430" fill-opacity="0.6" font-size="10" font-family="Inter, sans-serif">Salida/Meta</text>
			<text x="282" y="88" fill="#1f2430" fill-opacity="0.6" font-size="10" font-family="Inter, sans-serif">5K</text>
			<text x="586" y="88" fill="#1f2430" fill-opacity="0.6" font-size="10" font-family="Inter, sans-serif" text-anchor="end">10K</text>
		</svg>
		<p class="mt-2 text-[11px] leading-relaxed text-tinta/50">
			Circuito urbano prácticamente llano. Una vuelta = 5K (5K de iniciación); la 10K consta de dos
			vueltas. Perfil orientativo.
		</p>
	</div>
</div>

<script>
	import L from 'leaflet';
	import type { FeatureCollection } from 'geojson';
	import { RECORRIDO_CIRCUITO } from '../lib/recorrido';

	function iniciarMapa() {
		const container = document.getElementById('mapa-recorrido');
		if (!container || container.dataset.mapIniciado === 'true') return;

		const centro = { lat: 39.4038, lng: -2.42942 };

		const recorrido: FeatureCollection = {
			type: 'FeatureCollection',
			features: [
				{
					type: 'Feature',
					properties: {
						id: 'start-finish',
						name: 'Salida y Meta',
						category: 'milestone',
						description: 'Plaza Mayor de San Clemente frente al Ayuntamiento',
					},
					geometry: {
						type: 'Point',
						coordinates: [-2.429415344812119, 39.40380666292331],
					},
				},
				{
					type: 'Feature',
					properties: {
						id: 'race-track',
						name: 'Circuito Urbano 5K / 10K',
						category: 'track',
						description:
							'Recorrido circular por el casco histórico y principales vías urbanas de San Clemente',
					},
					geometry: {
						type: 'LineString',
						coordinates: RECORRIDO_CIRCUITO as unknown as [number, number][],
					},
				},
			],
		};

		const mapa = L.map(container, {
			center: [centro.lat, centro.lng],
			zoom: 16,
			scrollWheelZoom: true,
		});

		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution:
				'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
		}).addTo(mapa);

		const etiquetaCategoria: Record<string, string> = {
			milestone: 'Salida y Meta',
			track: 'Recorrido',
		};

		const contenidoPopup = (propiedades: {
			category?: string;
			name?: string;
			description?: string;
		}) => {
			const categoria = etiquetaCategoria[propiedades.category ?? ''] ?? propiedades.category;
			return `
				<div class="popup-recorrido">
					<span class="popup-recorrido__categoria">${categoria}</span>
					<strong class="popup-recorrido__titulo">${propiedades.name}</strong>
					<p class="popup-recorrido__descripcion">${propiedades.description}</p>
				</div>`;
		};

		const cargarPunto = (feature: any, latlng: L.LatLng) => {
			const icono = L.divIcon({
				className: '',
				html: `<div class="marcador-mapa marcador-mapa--salida" role="img" aria-label="${feature.properties.name}"><span>🏁</span></div>`,
				iconSize: [38, 44],
				iconAnchor: [19, 44],
				popupAnchor: [0, -40],
			});

			return L.marker(latlng, { icon: icono });
		};

		L.geoJSON(recorrido, {
			style: () => ({
				color: '#e63946',
				weight: 4,
				opacity: 0.9,
			}),
			pointToLayer: cargarPunto,
			onEachFeature: (feature, layer) => {
				layer.bindPopup(contenidoPopup(feature.properties), {
					minWidth: 220,
				});
				if (feature.geometry.type === 'LineString') {
					layer.on('click', () => layer.openPopup());
				}
			},
		}).addTo(mapa);

		const limites = L.latLngBounds([]);
		recorrido.features.forEach((feature) => {
			if (feature.geometry.type === 'LineString') {
				feature.geometry.coordinates.forEach(([lng, lat]) =>
					limites.extend([lat, lng]),
				);
			} else if (feature.geometry.type === 'Point') {
				const [lng, lat] = feature.geometry.coordinates;
				limites.extend([lat, lng]);
			}
		});
		mapa.fitBounds(limites, { padding: [32, 32] });

		container.dataset.mapIniciado = 'true';
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', iniciarMapa);
	} else {
		iniciarMapa();
	}

	document.addEventListener('astro:page-load', iniciarMapa);
</script>

<style is:global>
	.marcador-mapa {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50% 50% 50% 0;
		transform: rotate(-45deg);
		border: 3px solid #ffffff;
		box-shadow: 0 4px 12px rgba(10, 31, 68, 0.45);
	}
	.marcador-mapa span {
		transform: rotate(45deg);
		font-size: 18px;
		line-height: 1;
	}
	.marcador-mapa--salida {
		background: #e63946;
	}
	.popup-recorrido {
		font-family: inherit;
		padding: 4px 0;
	}
	.popup-recorrido__categoria {
		display: inline-block;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #a9853b;
	}
	.popup-recorrido__titulo {
		display: block;
		margin-top: 2px;
		font-size: 13px;
		color: #0a1f44;
	}
	.popup-recorrido__descripcion {
		margin-top: 4px;
		font-size: 12px;
		line-height: 1.4;
		color: #1f2430;
		opacity: 0.85;
	}
</style>