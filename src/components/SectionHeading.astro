---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
	tone?: 'light' | 'dark';
	class?: string;
}
const { eyebrow, title, description, align = 'center', tone = 'light', class: className = '' } = Astro.props;

const tituloClase = tone === 'dark' ? 'text-white' : 'text-nocturno';
const descripcionClase = tone === 'dark' ? 'text-white/80' : 'text-tinta/70';
const eyebrowClase = tone === 'dark' ? 'text-albero' : 'text-albero-600';
---

<div class={`mx-auto max-w-2xl ${align === 'center' ? 'text-center' : ''} ${className}`}>
	{eyebrow && (
		<p class={`text-xs font-bold uppercase tracking-[0.2em] ${eyebrowClase}`}>{eyebrow}</p>
	)}
	<h2 class={`mt-3 font-display text-3xl font-bold sm:text-4xl ${tituloClase}`}>{title}</h2>
	{description && <p class={`mt-4 text-lg leading-relaxed ${descripcionClase}`}>{description}</p>}
	<div
		class={`mt-5 h-1 w-14 rounded-full bg-albero ${align === 'center' ? 'mx-auto' : ''}`}
	/>
</div>
