---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
	class?: string;
}
const { eyebrow, title, description, align = 'center', class: className = '' } = Astro.props;
---

<div class={`mx-auto max-w-2xl ${align === 'center' ? 'text-center' : ''} ${className}`}>
	{eyebrow && (
		<p class="text-xs font-bold uppercase tracking-[0.2em] text-albero-600">{eyebrow}</p>
	)}
	<h2 class="mt-3 font-display text-3xl font-bold text-nocturno sm:text-4xl">{title}</h2>
	{description && <p class="mt-4 text-lg leading-relaxed text-tinta/70">{description}</p>}
	<div
		class={`mt-5 h-1 w-14 rounded-full bg-albero ${align === 'center' ? 'mx-auto' : ''}`}
	/>
</div>
