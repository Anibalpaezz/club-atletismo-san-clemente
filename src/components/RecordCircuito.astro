---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import TablaResultados from './TablaResultados';
import { RECORDS_CIRCUITO } from '../lib/records';
import type { RecordInfo } from '../lib/tabla-resultados';
import { aplanarResultados, calcularRecords, clasificados } from '../lib/tabla-resultados';

const ediciones = (await getCollection('resultadosCronomancha')).map((e) => e.data);
const hayDatos = ediciones.some((e) => e.results.length > 0);
const filas = aplanarResultados(ediciones);
const clasificados10k = clasificados(filas);

// Récords calculados desde los datos sincronizados de la 10K; si no hay datos,
// se usan como respaldo los manuales de src/lib/records.ts (pendientes del club).
const calculados = calcularRecords(ediciones, '10K');
const records: RecordInfo[] = calculados.map((calc) => {
	if (calc.nombre && calc.tiempo) return calc;
	const manual = RECORDS_CIRCUITO.find(
		(m) => m.categoria === calc.categoria && m.nombre && m.tiempo,
	);
	if (manual) {
		return {
			categoria: calc.categoria,
			nombre: manual.nombre,
			tiempo: manual.tiempo,
			año: manual.año,
			club: null,
		};
	}
	return calc;
});
---

<section id="records" class="scroll-mt-20 bg-hueso py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading
			eyebrow="Récords del circuito"
			title="Las mejores marcas de la 10K Nocturna"
			description="Los nombres escritos con letras de oro: récords absolutos del circuito urbano de San Clemente, y la clasificación completa de cada edición."
		/>

		<div class="mt-12 overflow-hidden rounded-2xl border-2 border-albero bg-nocturno text-white shadow-xl shadow-nocturno/20">
			<div class="flex items-center gap-3 border-b border-white/10 px-6 py-4 sm:px-8">
				<span class="flex h-11 w-11 items-center justify-center rounded-full bg-albero/15 text-albero">
					<Icon name="trophy" class="h-6 w-6" />
				</span>
				<div>
					<p class="text-xs font-bold uppercase tracking-widest text-albero">Récords absolutos</p>
					<p class="text-sm text-white/70">10.000 metros · Circuito urbano</p>
				</div>
			</div>

			<div class="grid gap-px bg-white/10 sm:grid-cols-2">
				{records.map((record) => (
					<div class="bg-nocturno px-6 py-6 sm:px-8">
						<p class="text-[11px] font-bold uppercase tracking-[0.15em] text-albero">
							{record.categoria}
						</p>
						{record.nombre && record.tiempo ? (
							<div class="mt-2">
								<p class="font-display text-3xl font-bold text-albero">{record.tiempo}</p>
								<p class="mt-1 text-sm font-semibold text-white">{record.nombre}</p>
								<p class="mt-0.5 text-xs text-white/50">
									{record.año ? `Edición ${record.año}` : ''}
									{record.año && record.club ? ' · ' : ''}
									{record.club ?? ''}
								</p>
							</div>
						) : (
							<p class="mt-3 text-sm font-semibold text-white/60">Por confirmar</p>
						)}
					</div>
				))}
			</div>
		</div>

		{hayDatos ? (
			<>
				<div class="mt-10">
					<TablaResultados client:visible filas={clasificados10k} />
				</div>

				{ediciones.some((e) => e.official_url) && (
					<div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
						{ediciones
							.filter((e) => e.official_url)
							.map((e) => (
								<a
									href={e.official_url!}
									target="_blank"
									rel="noreferrer noopener"
									class="inline-flex items-center gap-1.5 text-sm font-semibold text-albero-600 transition hover:text-nocturno"
								>
									Ver ficha oficial en Cronomancha · {e.year} {e.race}
									<Icon name="external" class="h-3.5 w-3.5" />
								</a>
							))}
					</div>
				)}
			</>
		) : (
			<div class="mt-10 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
				<p class="text-sm leading-relaxed text-tinta/60">
					Resultados disponibles próximamente. La clasificación completa de cada edición se
					publicará aquí tras la carrera, sincronizada con Cronomancha.
				</p>
			</div>
		)}
	</div>
</section>