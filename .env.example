# Copia este fichero a ".env" y rellena los valores desde Supabase (Project Settings → API).
# Las claves anónimas son públicas por diseño (la seguridad se controla con RLS en la base de datos).

# URL del proyecto (ej: https://xyz.supabase.co)
PUBLIC_SUPABASE_URL=

# Clave pública "anon" (pública, no es un secreto)
PUBLIC_SUPABASE_ANON_KEY=

# Opcional: URL de una fotografía real de la Plaza Mayor de San Clemente para el Hero.
# Si se deja vacío se usa una imagen genérica por defecto.
PUBLIC_HERO_IMAGE_URL=
